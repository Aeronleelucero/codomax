NODE_ENV=development
PORT=5000
# Exact browser origins, comma-separated. Include every Vite URL you use.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Runtime database: PostgreSQL / Supabase (never commit a real connection string).
DATABASE_URL=postgresql://artikly_user:replace_me@localhost:5432/artikly_db
# Local database only. Remove this line for Supabase/production (verified TLS).
PGSSLMODE=disable
# Supabase: remove PGSSLMODE=disable above and set:
# PGSSLROOTCERT=certs/supabase-root-2021.crt
# Relative CA paths resolve from backend/. NODE_EXTRA_CA_CERTS also works when exported before Node starts.

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters
SESSION_TTL_HOURS=24
# Set only to the exact number of trusted reverse-proxy hops; 0 = direct.
TRUST_PROXY_HOPS=0

# Optional regression tests against an isolated schema in a TEST database:
# TEST_PGSSLMODE=disable  # only for a separate local test database
# TEST_DATABASE_URL=postgresql://test_user:replace_me@localhost:5432/artikly_test

# Legacy MySQL-to-PostgreSQL migration only (not used by the running API):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=artikly_user
# DB_PASSWORD=replace_me
# DB_NAME=artikly_db

# Prefer exact proxy IPs/CIDRs in production; takes precedence over hop count.
# TRUST_PROXY_CIDRS=loopback
# See .env.production.example and ../deploy/PRODUCTION.md.
