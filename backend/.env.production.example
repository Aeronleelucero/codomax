# Copy values into your deployment secret/config manager; never commit secrets.
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://blog.example.com
DATABASE_URL=
PGSSLMODE=verify-full
PGSSLROOTCERT=certs/supabase-root-2021.crt
SESSION_SECRET=
SESSION_TTL_HOURS=24
# Same-host proxy example only. Use your actual proxy IPs/CIDRs otherwise.
TRUST_PROXY_CIDRS=loopback
TRUST_PROXY_HOPS=0
